<RCC>
  <qresource prefix="/">
    <file>app-icon.svg</file>
    <file>app.ico</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="cursor.svg">icons/cursor.svg</file>
    <file alias="crosshair.svg">icons/crosshair.svg</file>
    <file alias="trend-line.svg">icons/trend-line.svg</file>
    <file alias="h-line.svg">icons/h-line.svg</file>
    <file alias="v-line.svg">icons/v-line.svg</file>
    <file alias="rectangle.svg">icons/rectangle.svg</file>
    <file alias="fibonacci.svg">icons/fibonacci.svg</file>
    <file alias="brush.svg">icons/brush.svg</file>
    <file alias="long.svg">icons/long.svg</file>
    <file alias="short.svg">icons/short.svg</file>
    <file alias="arrow.svg">icons/arrow.svg</file>
    <file alias="text.svg">icons/text.svg</file>
    <file alias="ruler.svg">icons/ruler.svg</file>
    <file alias="magnet.svg">icons/magnet.svg</file>
    <file alias="lock.svg">icons/lock.svg</file>
    <file alias="eye.svg">icons/eye.svg</file>
    <file alias="trash.svg">icons/trash.svg</file>
    <file alias="chevron-right.svg">icons/chevron-right.svg</file>
    <file alias="chevron-left.svg">icons/chevron-left.svg</file>
    <file alias="chevron-down.svg">icons/chevron-down.svg</file>
    <file alias="chevron-up.svg">icons/chevron-up.svg</file>
    <file alias="refresh.svg">icons/refresh.svg</file>
    <file alias="settings.svg">icons/settings.svg</file>
    <file alias="bell.svg">icons/bell.svg</file>
    <file alias="indicator.svg">icons/indicator.svg</file>
    <file alias="function.svg">icons/function.svg</file>
    <file alias="history.svg">icons/history.svg</file>
    <file alias="minus.svg">icons/minus.svg</file>
    <file alias="square.svg">icons/square.svg</file>
    <file alias="close.svg">icons/close.svg</file>
    <file alias="restore.svg">icons/restore.svg</file>
    <file alias="play.svg">icons/play.svg</file>
    <file alias="pause.svg">icons/pause.svg</file>
    <file alias="skip-back.svg">icons/skip-back.svg</file>
    <file alias="skip-forward.svg">icons/skip-forward.svg</file>
    <file alias="download.svg">icons/download.svg</file>
