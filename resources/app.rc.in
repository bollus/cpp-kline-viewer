IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @Q4J_APP_VERSION_RC@
 PRODUCTVERSION @Q4J_APP_VERSION_RC@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Q4J"
      VALUE "FileDescription", "Q4J K-Line Viewer"
      VALUE "FileVersion", "@Q4J_APP_VERSION@"
      VALUE "InternalName", "q4j_kline_viewer"
      VALUE "OriginalFilename", "q4j_kline_viewer.exe"
      VALUE "ProductName", "Q4J K-Line Viewer"
      VALUE "ProductVersion", "@Q4J_APP_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
